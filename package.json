{
  "name": "glasses-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在 DeepSeek Harness 里自定义亮亮视野 (LLVision) Leion Pro / GLXSS ME AR 眼镜插件，并搭中↔巴西葡语双向同传 app",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check",
    "test": "node tests/run-all.mjs",
    "verify": "node scripts/generate.mjs --check && node tests/run-all.mjs",
    "verify:live": "node tests/live/run.mjs",
    "show-prompt": "node scripts/show-prompt.mjs",
    "bridge": "node bridge/asr-bridge.mjs",
    "demo": "node bridge/asr-bridge.mjs --inbox .tmp/asr-inbox.jsonl --engine replay --replay bridge/sample-transcript.txt --truncate",
    "harness-side": "node scripts/harness-side.mjs",
    "relay": "node relay/lan-relay.mjs",
    "apk": "node scripts/build-apk.mjs"
  }
}
