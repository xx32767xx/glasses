<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 和电脑上的局域网转发进程通信 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 录音上传：把麦克风音频传给电脑识别 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      ══════════════════════════════════════════════════════════════════════════
      眼镜 SDK（platform-4.8.0.4-release.aar）会把自己的清单合并进来，
      带了一大堆权限。下面用 tools:node="remove" 删掉**确定用不到**的，
      剩下的**必须留着** —— 理由逐条写在下面。

      ⚠️ 血泪教训（真机上踩到）：先版本我把 CAMERA / 媒体 / 悬浮窗 全删了，
         结果**插上眼镜完全不弹「允许访问眼镜吗」**，而官方 App 会弹。
         对齐官方样例（GlassPermissionFlow.kt 的 glassRuntimePermissions() 与
         GlassMainViewModel: "权限与悬浮窗就绪后，由界面调用以初始化 Glass SDK"）
         之后才明白：**SDK 的前提是这些权限已经给齐**。见 docs/09 第 5 节。
      ══════════════════════════════════════════════════════════════════════════
    -->

    <!-- 眼镜 SDK 需要：它要访问眼镜的相机（UVC）才能建立与通电。
         我们不显示画面，但**必须给权限**，否则 SDK 起不来、USB 授权也不会弹。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 眼镜 SDK 的媒体访问（官方 glassRuntimePermissions() 里就有这几条，
         Android 13/14 分档请求）。给不全时 SDK 的连接流程会卡住。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- 存储：Android 12 及以下要这两条（官方的 else 分支就是这么给的） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 悬浮窗：官方把它和运行时权限并列为"初始化 SDK 的前置条件"之一
         （canDrawOverlays 不给就不往下走）。SDK 的投屏相关流程会用到。
         ⚠️ 这条与"上架审核"无关：SYSTEM_ALERT_WINDOW 是正常权限，不是全盘访问。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 第三方 USB 相机（StdUVCCameraService）与投屏前台服务要用 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!--
      以下**仍然删掉**（逐条理由）：
    -->
    <!-- ⚠️ 全盘访问（MANAGE_EXTERNAL_STORAGE）**上架必被拒**，且我们只写自己的应用目录 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- 设备电源 / 电话：与业务无关 -->
    <uses-permission android:name="android.permission.DEVICE_POWER" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove" />
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS" tools:node="remove" />
    <!-- 网络状态：我们只直连 http://ip:port，不判断网络类型 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" tools:node="remove" />

    <!--
      ══════════════════════════════════════════════════════════════════════════
      ⚠️⚠️ 不要再删 FOREGROUND_SERVICE_* 了 —— 删了必崩。

      真机崩溃（Android 14 / targetSdk 34）：

        RuntimeException: Unable to start service
          com.llvision.glxss.common.service.audio.GlassAudioService
        Caused by: SecurityException: Starting FGS with type microphone ...
          requires permissions: allOf=true
          [android.permission.FOREGROUND_SERVICE_MICROPHONE]

      原因：**SDK 自己的服务在 AAR 里声明了 foregroundServiceType**
      （合并后的清单里能看到三条：microphone / camera / mediaProjection），
      而它们各自要求**同名的** FOREGROUND_SERVICE_* 权限。
      我一厢情愿地认为"我们投的是自己构造的 View、不是录屏，所以不需要"
      就把这两条删了 —— 结果是 SDK 的服务一启动就 SecurityException，整个 App 崩。

      规则：**AAR 声明了 foregroundServiceType，就必须有配套的权限。**
      这类"声明/权限成对出现"的东西不能单方面删一半 —— 删之前先看
      合并后的清单里有没有对应的 service 声明。
      （同类错误第二次了：第一次是删 CAMERA 导致 USB 授权框不弹。）
      ══════════════════════════════════════════════════════════════════════════
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        tools:replace="android:supportsRtl">
        <!--
          usesCleartextTraffic：局域网里走的是明文 http://192.168.x.x:8788。
          Android 9 起默认禁止明文流量，所以必须显式打开。
          这只是验证用；真要上线应当换成 https 或改用不依赖明文的方案。

          supportsRtl="true" + tools:replace：眼镜 SDK 的清单声明了 true，
          与我们原来的 false 冲突（manifest merger 直接报错）。选 true 是**故意的**：
          葡语/中文都不涉及 RTL，对界面没有影响；而 SDK 自己需要它。
          用 tools:replace 明确表态，而不是靠改我们的值去"碰巧不冲突"。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
