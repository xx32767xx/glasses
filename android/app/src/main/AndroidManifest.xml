<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 和电脑上的局域网转发进程通信 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 听写：把说的话变成文字 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      API 30+ 的包可见性规则：不声明这一条，SpeechRecognizer.isRecognitionAvailable
      可能返回 false。声明我们只是要"找那个语音识别服务"。
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic：局域网里走的是明文 http://192.168.x.x:8788。
          Android 9 起默认禁止明文流量，所以必须显式打开。
          这只是验证用；真要上线应当换成 https 或改用不依赖明文的方案。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
