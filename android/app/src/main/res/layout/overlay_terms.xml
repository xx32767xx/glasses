<?xml version="1.0" encoding="utf-8"?>
<!--
  热词对照表（开发者向的配置页，从设置进来）。

  为什么用"一行一条 = 等号分隔"的文本框，而不是一条条可增删的列表：
  用户填的是**成批的名字**（常见是十几条），列表式界面要点"新增"N 次；
  而文本可以整体粘贴（从微信/Word 里贴过来最省事），也方便一次改好再传。
  代价是这里要解析文本 —— 所以解析失败必须**逐行报出来**，不能静默忽略
  （静默忽略的后果是"我明明填了，怎么没生效"）。

  校验在**电脑端**做（POST /terms/validate），这一页只负责收集文本、显示结果。
  这样"手机上的预校验"和"真正上传时的校验"是同一份代码，不会两套说法。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/termsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tap_icon_bare"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/terms_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terms_intro"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <!-- 用户名：电脑按它区分是谁的表；留空 → default -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/terms_user_label"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/termsUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:hint="@string/terms_user_hint"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <!-- 对照表本体 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/terms_entries_label"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/termsEntries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:fontFamily="monospace"
                android:gravity="top"
                android:hint="@string/terms_entries_hint"
                android:inputType="textMultiLine"
                android:minLines="6"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <!-- 三个动作：校验 / 上传 / 从电脑拉取 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/termsValidate"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/tap_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/terms_validate"
                    android:textColor="@color/brand"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/termsUpload"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/tap_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/terms_upload"
                    android:textColor="@color/brand"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/termsLoad"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/tap_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/terms_load"
                    android:textColor="@color/brand"
                    android:textSize="13sp" />
            </LinearLayout>

            <!--
              结果区：分成三块，各自颜色不同 ——
                状态行：这次动作的结果（成功/失败/等你改完）
                提醒：不影响上传，但用户该知道（比如"2 个字的名字容易被更长的词命中"）
                拒绝原因：**必须逐条列出第几行、什么错**，否则用户没法改
            -->
            <TextView
                android:id="@+id/termsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/terms_status_idle"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/termsWarnTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/terms_warn_title"
                android:textColor="@color/warn"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/termsWarnBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="4dp"
                android:textColor="@color/ink_soft"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/termsRejectTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/terms_reject_title"
                android:textColor="@color/err"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/termsRejectBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="4dp"
                android:textColor="@color/ink_soft"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
