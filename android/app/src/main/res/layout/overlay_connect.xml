<?xml version="1.0" encoding="utf-8"?>
<!--
  连接电脑（独立全屏页）。规范要点：
    · 说明文字："手机需要连接电脑上的同传服务。"
    · 扫码入口**不提供** —— 电脑端还不能生成二维码，规范自己写着"不做只有外观的功能"，
      所以这里只留一行说明，让用户知道为什么没有。
    · 地址示例放在输入框提示里，主界面不暴露地址/端口/模型参数。
    · 连接过程按真实进度分三步显示（正在连接电脑 / 正在检查同传服务 / 服务已就绪）。
    · 失败时保留输入，提供重试。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/connectBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tap_icon_bare"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/connect_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/connect_intro"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <!-- 手动连接 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/connect_manual"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/connectHost"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/connect_address_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/connectSecret"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/connect_pairing_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/connectTest"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/tap_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/connectTestLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/connect_test"
                        android:textColor="@color/on_brand"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- 连接过程的真实进度（哪一步就是哪一步，不假装） -->
                <LinearLayout
                    android:id="@+id/connectProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/connectProgressDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_dot" />

                    <TextView
                        android:id="@+id/connectProgressText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/ink_soft"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 最近成功连接 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/connect_recent"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/recentEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect_recent_empty"
                android:textColor="@color/ink_faint"
                android:textSize="13sp" />

            <!-- 连接详情：连上之后把设备名与能力摆在这里 -->
            <LinearLayout
                android:id="@+id/connectDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/detailDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/detailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/detail_caps"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/detail_caps_langs"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/detail_caps_audio"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 为什么没有扫码入口：如实说明，而不是放一个点了没用的按钮 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/connect_scanned_hint"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
