<?xml version="1.0" encoding="utf-8"?>
<!--
  page_room.xml —— 房间内页（核心页）：主区字幕、底部单行控制、右侧竖向悬浮条。

  视觉按原型（4.47）：
    · 页面浅灰底，字幕流放在**白卡片**里（14dp 圆角、细描边）—— 主区占绝大部分
    · 主行 = 我的语言译文（大字、粗体、@color/ink）；副行 = 原始发言（小字、@color/ink_soft）
    · 右侧竖向条：上格当前发言人，下格 投屏 / 扩声 / 收音 三行
    · 底部单行控制：主操作（开麦/开始同传）走渐变，其余走白底描边
  ⚠️ 颜色与尺寸只用 token（@color / @dimen），不写死值。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_page"
        android:paddingTop="@dimen/space_gap"
        android:paddingEnd="@dimen/space_gap_small"
        android:paddingBottom="@dimen/space_gap_small">

        <!-- 连接/推送状态：一行人类可读文字 -->
        <TextView
            android:id="@+id/roomStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="连接中…"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_caption" />

        <!-- 主区：字幕流（白卡片 + 底部对齐，新句从下往上推） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_gap_small"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/space_card">

            <TextView
                android:id="@+id/roomMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/space_gap_tiny"
                android:maxLines="6"
                android:text=""
                android:textColor="@color/ink"
                android:textSize="@dimen/text_live"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/roomSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_small"
                android:maxLines="3"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- 行内提示：琥珀（生成中 / 被顶替 / 掉线释放…） -->
        <TextView
            android:id="@+id/roomHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_small"
            android:background="@drawable/bg_hint"
            android:minHeight="@dimen/space_section"
            android:paddingStart="@dimen/space_gap_small"
            android:paddingTop="@dimen/space_gap_tiny"
            android:paddingEnd="@dimen/space_gap_small"
            android:paddingBottom="@dimen/space_gap_tiny"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="@dimen/text_caption" />

        <!-- 底部单行控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_small"
            android:orientation="horizontal">

            <Button
                android:id="@+id/roomMic"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_weight="1.4"
                android:background="@drawable/tap_btn_secondary"
                android:text="点击开麦"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_button" />

            <Button
                android:id="@+id/roomUpload"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_marginStart="@dimen/space_gap_small"
                android:layout_weight="1.4"
                android:background="@drawable/tap_btn_primary"
                android:text="开始同传"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_button" />

            <Button
                android:id="@+id/roomLock"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_marginStart="@dimen/space_gap_small"
                android:layout_weight="1.2"
                android:background="@drawable/tap_btn_secondary"
                android:text="锁定发言"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_secondary" />

            <Button
                android:id="@+id/roomLeave"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_button"
                android:layout_marginStart="@dimen/space_gap_small"
                android:background="@drawable/tap_btn_secondary"
                android:minWidth="@dimen/touch_min"
                android:text="退出"
                android:textAllCaps="false"
                android:textColor="@color/err"
                android:textSize="@dimen/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧竖向悬浮条：当前发言人 + 投屏/扩声/收音 -->
    <LinearLayout
        android:layout_width="@dimen/speaker_bar_width"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_gap"
        android:layout_marginEnd="@dimen/space_page"
        android:layout_marginBottom="@dimen/space_gap"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/space_gap_small">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发言人"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/roomSpeaker"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:layout_weight="1"
            android:gravity="top"
            android:text="麦克风空闲"
            android:textColor="@color/brand"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_hairline"
            android:layout_marginTop="@dimen/space_gap_small"
            android:layout_marginBottom="@dimen/space_gap_small"
            android:background="@color/line_soft" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="投屏"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手机屏"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_small"
            android:text="扩声"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="耳机 / 关"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_small"
            android:text="收音"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手机麦"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</LinearLayout>
