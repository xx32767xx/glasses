<?xml version="1.0" encoding="utf-8"?>
<!--
  音频输出底部弹层。
  规范：只有服务支持译文音频时才启用"播放译文"。当前服务**不提供**译文语音，
  所以那一项是禁用状态 + 一句说明，不做成能点却没反应的样子。
  选择扬声器时会提示建议用耳机（因为译文声音会被麦克风再次收录，
  而这个系统**没有**回声消除 —— 不能宣称有）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/output_title"
        android:textColor="@color/ink"
        android:textSize="17sp" />

    <LinearLayout
        android:id="@+id/outputSubtitleOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/tap_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/output_subtitle_only"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/output_subtitle_only_hint"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/outputCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/confirm"
            android:src="@drawable/ic_check" />
    </LinearLayout>

    <!-- 播放译文：服务不支持 → 禁用 + 说明 -->
    <LinearLayout
        android:id="@+id/outputPlayTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.45"
        android:background="@drawable/tap_nav_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/output_play_translation"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/output_play_unavailable"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/output_device"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/outputDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/output_phone_speaker"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/outputWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/output_speaker_warning"
        android:textColor="@color/warn"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
