<?xml version="1.0" encoding="utf-8"?>
<!--
  眼镜显示预览（开发者用途，规范里没有这一页）。
  为什么保留：这个 App 的原始目的就是"没有真眼镜时用它预览眼镜上会显示成什么样"，
  所以那块严格按 40 列 × 3 行折行的深色屏幕不能丢 —— 只是不再占据同传主界面，
  而是从设置里进来。字号仍是自动算的（见 MainActivity.applyPanelMetrics）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/glassesBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tap_icon_bare"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/glasses_preview_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <!--
      真眼镜（USB 接的那副）的状态与开关。
      为什么必须显示：眼镜连没连上、投屏成没成功，**在手机上看不出来** ——
      而这套 SDK 的失败大多是"什么都不显示"。不写这一行，出问题只能靠猜。
      SDK 的显示接口是"投屏"（见 docs/09-眼镜SDK接入.md），所以这里说的是"投屏"而不是"发送"。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/glassesRealStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/glasses_real_idle"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/glassesRealToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tap_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="@string/glasses_real_cast"
            android:textColor="@color/brand"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/glassesBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:textColor="@color/screen_ink_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/glassesPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="6dp"
            android:text="@string/glasses_preview_empty"
            android:textColor="@color/screen_ink"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/glassesCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/ink_faint"
        android:textSize="12sp" />
</LinearLayout>
