<?xml version="1.0" encoding="utf-8"?>
<!--
  眼镜显示预览（开发者用途，规范里没有这一页）。
  为什么保留：这个 App 的原始目的就是"没有真眼镜时用它预览眼镜上会显示成什么样"，
  所以那块严格按 40 列 × 3 行折行的深色屏幕不能丢 —— 只是不再占据同传主界面，
  而是从设置里进来。字号仍是自动算的（见 MainActivity.applyPanelMetrics）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/glassesBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tap_icon_bare"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/glassesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/glasses_preview_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <!--
      真眼镜（USB 接的那副）的状态与开关。
      为什么必须显示：眼镜连没连上、投屏成没成功，**在手机上看不出来** ——
      而这套 SDK 的失败大多是"什么都不显示"。不写这一行，出问题只能靠猜。
      SDK 的显示接口是"投屏"（见 docs/09-眼镜SDK接入.md），所以这里说的是"投屏"而不是"发送"。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/glassesRealStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/glasses_real_idle"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/glassesRealToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tap_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="@string/glasses_real_cast"
            android:textColor="@color/brand"
            android:textSize="13sp" />
    </LinearLayout>

    <!--
      诊断行：每一步单独可见 —— 哪一步是 0 / false 就是卡在哪。
      为什么要它：真机上 adb 不一定能用（沙箱里 adb 服务端起不来），
      所以**必须让 App 自己把"卡在哪一步"说出来**，不然只能靠猜。
    -->
    <TextView
        android:id="@+id/glassesRealDiag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="monospace"
        android:textColor="@color/ink_soft"
        android:textSize="11sp" />

    <!--
      显示微调：字号 / 左留白 / 右留白。
      为什么做成真机可调：眼镜上的实际观感取决于光波导放大率、佩戴位置、环境亮度，
      在电脑上推不出来。而投屏是**实时采样**这块 View 的，所以调完立刻在眼镜上生效，
      不用重新投屏、也不用重新打包 —— 真机上"字太小""右边看不清"这类问题
      这样才能调到合适，而不是靠改代码反复试。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/glasses_tune_font_zh"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/glassesFontZhMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_minus"
                android:textColor="@color/brand"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/glassesFontZhValue"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/glassesFontZhPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_plus"
                android:textColor="@color/brand"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/glasses_tune_font_pt"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/glassesFontPtMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_minus"
                android:textColor="@color/brand"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/glassesFontPtValue"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/glassesFontPtPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_plus"
                android:textColor="@color/brand"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/glasses_tune_right"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/glassesRightMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_minus"
                android:textColor="@color/brand"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/glassesRightValue"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/glassesRightPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_plus"
                android:textColor="@color/brand"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/glasses_tune_left"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/glassesLeftMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_minus"
                android:textColor="@color/brand"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/glassesLeftValue"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/glassesLeftPlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_plus"
                android:textColor="@color/brand"
                android:textSize="18sp" />
        </LinearLayout>

        <!--
          翻页间隔：长句放不下时，先显示开头、等这么久换成结尾（并停在结尾）。
          多久合适只有戴上才知道 —— 太快读不完，太慢下一句就来了。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/glasses_tune_page_delay"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/glassesPageMinus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_minus"
                android:textColor="@color/brand"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/glassesPageValue"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/glassesPagePlus"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/glasses_tune_plus"
                android:textColor="@color/brand"
                android:textSize="18sp" />
        </LinearLayout>

        <!--
          边界标尺：戴上眼镜看一眼就知道"哪一部分看不见"。
          比来回描述快得多 —— 外框是画布边界，黄框是字幕实际会落的安全区。
        -->
        <LinearLayout
            android:id="@+id/glassesRulerToggle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/tap_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/glassesRulerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/glasses_tune_ruler"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
          排版自检：在**真机上真的排一遍**，报出"这个字号一行能放几个字、一页几行"。
          为什么需要它：选字号时我算过一张"字号 → 每行字数"的表，但那是模型估的
          （中文≈1em、拉丁≈0.5em）。葡语的宽字母比 0.5em 宽，估算会偏乐观 ——
          上一轮"句尾几个词被省略号吃掉"就是这个偏差造成的。
          所以这里不猜：用当前字号把两句真实样例排一遍，给用户看实况数字。
        -->
        <LinearLayout
            android:id="@+id/glassesSelfCheck"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/tap_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/glasses_self_check"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
          音源：眼镜 / 手机。
          眼镜戴在说话人脸上（离嘴十几厘米），手机常在兜里或桌上（一两米开外）——
          识别准确率对信噪比极敏感，所以音源这条要能切换，便于同一次实验里 A/B 对比。
        -->
        <LinearLayout
            android:id="@+id/glassesMicToggle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/tap_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/glassesMicLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/glasses_mic_source"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
          相机预览背景：把摄像头画面垫在字幕底下。
          眼镜是透视的，真实世界本来就看得见 —— 但"哪种效果更好"只有戴上才知道，
          所以做成开关让用户自己验证，而不是替他拍板。
        -->
        <LinearLayout
            android:id="@+id/glassesCameraToggle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/tap_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/glassesCameraLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/glasses_camera_bg"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/glassesBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:textColor="@color/screen_ink_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/glassesPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="6dp"
            android:text="@string/glasses_preview_empty"
            android:textColor="@color/screen_ink"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/glassesCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/ink_faint"
        android:textSize="12sp" />
</LinearLayout>
