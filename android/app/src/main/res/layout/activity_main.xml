<?xml version="1.0" encoding="utf-8"?>
<!--
  极简布局：一块"虚拟眼镜屏幕" + 连接设置 + 一个听写大按钮 + 状态行。
  刻意不引入任何 AndroidX / Material 控件，全部用平台 View。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panelCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:text="未连接" />

        <!-- 虚拟眼镜屏幕：严格按服务器给的显示预算折行，不自己重排 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/panel_placeholder"
                android:textColor="#E8F0F2"
                android:textSize="16sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_host"
            android:inputType="textUri"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_secret"
            android:inputType="text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/connectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/connect" />

            <Button
                android:id="@+id/langButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="听葡语" />
        </LinearLayout>

        <!--
          录音上传：**本机上唯一真能用的语音输入**。
          这台设备的系统语音识别服务不可用（已诊断确认），所以"对着说话出字幕"
          靠的是这条路 —— 手机只当麦克风，识别交给电脑上的 Whisper。
          放在系统听写按钮下面、手输框上面：按推荐程度排序。
        -->
        <Button
            android:id="@+id/recordButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:text="@string/start_record"
            android:textSize="16sp" />

        <Button
            android:id="@+id/micButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/start_listen"
            android:textSize="14sp" />

        <!--
          不依赖语音识别的输入通道：手输一句话直接送走。
          它的意义是"把链路验证和语音识别解耦" —— 语音识别是这台设备最容易出问题的环节，
          它坏了不该堵住"手机→电脑→翻译→字幕"这条主链路的验证。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/manualText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_manual"
                android:inputType="text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/send" />
        </LinearLayout>

        <Button
            android:id="@+id/diagnoseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/diagnose" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:text="填好电脑的地址和共享密钥，点连接。" />

    </LinearLayout>
</ScrollView>
