<?xml version="1.0" encoding="utf-8"?>
<!--
  外壳：一个内容容器 + 底部导航 + 一个覆盖层容器。

  为什么是"一个 Activity + 事件切换"而不是三个 Activity：
    · 同传这一页要保持长连接、计时、字幕列表三样状态，换 Activity 会全部重建
    · 连接电脑/语言选择/输出设备这些是**临时**界面（规范要求全屏弹层或独立页面），
      放在覆盖层容器里最省事，也不会打断后台的录音与轮询
  底部导航在"正在同传"时会被隐藏（规范要求把底部空间让给音频控制），
  由 MainActivity.setNavVisible() 控制。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

    <!-- 页面区（同传 / 记录 / 设置） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部导航：48dp 以上点击区，选中项是淡主色胶囊 -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/navLive"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/tap_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navLiveIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_live"
                    android:src="@drawable/ic_live" />

                <TextView
                    android:id="@+id/navLiveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_live"
                    android:textColor="@color/ink_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navRecords"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/tap_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navRecordsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_records"
                    android:src="@drawable/ic_records" />

                <TextView
                    android:id="@+id/navRecordsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_records"
                    android:textColor="@color/ink_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/tap_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navSettingsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_settings"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/navSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_settings"
                    android:textColor="@color/ink_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!--
              热词表：用户自己的名字对照表。放在底部导航而不是塞进设置里，
              因为它是**用户长期维护的东西**（一次配好、经常回来改），
              和"同传 / 记录 / 设置"同级更符合使用频率。
            -->
            <LinearLayout
                android:id="@+id/navTerms"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/tap_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navTermsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_terms"
                    android:src="@drawable/ic_records" />

                <TextView
                    android:id="@+id/navTermsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_terms"
                    android:textColor="@color/ink_faint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      覆盖层：连接电脑（全屏）、语言选择 / 输出设备（底部弹层）、全屏字幕、眼镜预览。
      默认全部 GONE —— 谁需要谁被 inflate 进来。
    -->
    <FrameLayout
        android:id="@+id/overlayHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
