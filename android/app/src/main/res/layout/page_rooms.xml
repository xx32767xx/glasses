<?xml version="1.0" encoding="utf-8"?>
<!--
  page_rooms.xml —— 会议房间大厅：填名字建房 / 填 6 位码加入 / 选"我说什么语言"。

  原型视觉（4.47）：浅灰底 + 白卡片（14dp 圆角、细描边）+ 主按钮渐变 + 12dp 圆角控件。
  ⚠️ 颜色与尺寸一律 token（@color / @dimen），不写死值 —— 深色模式与后续改版才不用动布局。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_page">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rooms_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roomsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_small"
            android:background="@drawable/bg_hint"
            android:padding="@dimen/space_gap_small"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="@dimen/text_secondary" />

        <!-- ── 我说什么语言 ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rooms_my_lang_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:text="@string/rooms_my_lang_hint"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roomsLangZh"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/rooms_speak_zh"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/roomsLangPt"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_gap_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/rooms_speak_pt"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 建房 ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rooms_create_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/roomsName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/bg_input"
                android:hint="@string/rooms_hint_name"
                android:inputType="text"
                android:paddingStart="@dimen/space_gap"
                android:paddingEnd="@dimen/space_gap"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/roomsCreate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/tap_btn_primary"
                android:text="@string/rooms_create"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_button" />

            <TextView
                android:id="@+id/roomsCodeBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/bg_hint"
                android:padding="@dimen/space_gap"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── 加入 ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rooms_join_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/roomsCode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/bg_input"
                android:hint="@string/rooms_hint_code"
                android:inputType="number"
                android:paddingStart="@dimen/space_gap"
                android:paddingEnd="@dimen/space_gap"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/roomsJoin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/tap_btn_secondary"
                android:text="@string/rooms_join"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
