<?xml version="1.0" encoding="utf-8"?>
<!--
  inc_bottom_nav.xml —— 底部一级导航（首页 / 历史 / 我的），4.62 起抽成公共片段。

  为什么抽出来：首页与「我的」都要有同一条导航，复制两份迟早会漂（一处改了另一处忘）。
  ⚠️ 这里的 id 是**固定契约**：两个页面都用同一套 findViewById，别改名。
  ⚠️ 导航固定贴在屏幕底部，所以引用它的页面必须把导航放在 ScrollView **之外**。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeBottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/line_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/homeNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/homeNavHomeIcon"
                android:layout_width="@dimen/icon_size_nav"
                android:layout_height="@dimen/icon_size_nav"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/ink_soft" />

            <TextView
                android:id="@+id/homeNavHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:text="@string/nav_home"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- 历史（会议记录）：下一步才做，现在灰着、没有动作 -->
        <LinearLayout
            android:id="@+id/homeNavHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/nav_history_soon"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/homeNavHistoryIcon"
                android:layout_width="@dimen/icon_size_nav"
                android:layout_height="@dimen/icon_size_nav"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_history"
                android:tint="@color/ink_faint" />

            <TextView
                android:id="@+id/homeNavHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:text="@string/nav_history"
                android:textColor="@color/ink_faint"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeNavMe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/homeNavMeIcon"
                android:layout_width="@dimen/icon_size_nav"
                android:layout_height="@dimen/icon_size_nav"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_me"
                android:tint="@color/ink_soft" />

            <TextView
                android:id="@+id/homeNavMeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:text="@string/nav_me"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
