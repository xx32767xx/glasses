<?xml version="1.0" encoding="utf-8"?>
<!-- 记录列表里的一条：标题 / 日期 / 方向 / 时长 / 一小段译文摘要 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/tap_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/recTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/recMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ink_faint"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/recExcerpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/recPartial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="@string/record_partial"
        android:textColor="@color/warn"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
