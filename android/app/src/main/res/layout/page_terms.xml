<?xml version="1.0" encoding="utf-8"?>
<!--
  术语库页（底部导航第 4 个栏位）。

  2026-10-23 起，用户端只做两件事：**选库** 与 **提申请**（docs/19）。
  旧模型的"自己编辑一张表 + 上传"整块**已隐藏**（不是删除）：
    · id 与对应的 Java 代码都还在 —— 删掉要连带改 MainActivity 十几处引用，
      迁移期保留可回滚；
    · 等管理员网页被信任、录入完全走管理端之后，再一次性删干净。
  想确认它确实藏起来了：本文件里三个容器的第一行属性是 android:visibility="gone"
  （表头+新增/批量导入、表格本体、底部校验/上传/拉取）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/terms_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/termsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 本次同传启用哪些库（docs/19：用户只能选库，不能改库内容） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/terms_libs_title"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/termsLibHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/terms_libs_hint"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/termsLibraries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/termsLibRefresh"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/terms_libs_refresh" />

            <TextView
                android:id="@+id/termsLibSave"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/terms_libs_save" />
        </LinearLayout>

        <TextView
            android:id="@+id/termsLibStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 我的申请（用户只能提申请，管理员审批） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/terms_req_title"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/termsReqNew"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terms_req_new" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/termsRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/termsReqHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/terms_req_hint"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 表头 + 两个按钮（新增 / 批量导入） -->
    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/terms_col_zh"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/terms_col_pt"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <!-- 5.02：三语术语的第三栏（这一整块仍是隐藏的旧录入界面，保留以便回滚） -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/terms_col_en"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/termsAdd"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/tap_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/terms_add"
            android:textColor="@color/brand"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/termsBatch"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/tap_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/terms_batch"
            android:textColor="@color/brand"
            android:textSize="13sp" />
    </LinearLayout>

    <!--
      表格本体：行由代码动态加（一条一行：中文 / 葡语 / 删除）。
      用 ScrollView + LinearLayout 而不是 RecyclerView —— 条目量级是几十条，
      而 RecyclerView 要多写一个 Adapter + ViewHolder，收益为零。
    -->
    <ScrollView
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/termsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:text="@string/terms_empty"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/termsRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部动作：校验 / 上传 / 从电脑拉取 -->
    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/termsUpload"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/terms_upload"
                android:textColor="@color/brand"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/termsLoad"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/terms_load"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/termsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/terms_status_idle"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/termsWarnTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/terms_warn_title"
            android:textColor="@color/warn"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/termsWarnBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingTop="2dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/termsRejectTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/terms_reject_title"
            android:textColor="@color/err"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/termsRejectBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingTop="2dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
