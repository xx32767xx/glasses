<?xml version="1.0" encoding="utf-8"?>
<!--
  page_history_detail.xml —— 单条历史记录的详情（4.69 先搭骨架）。

  ⚠️ 内容**下一轮才提供**：这一版只把卡片上已经有的信息摆好，并明说"字幕与逐句内容下一步"。
     不做假的页面（不摆空图表、不摆占位按钮）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_page">

            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_page_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_small"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detailKind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_brand"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingTop="@dimen/space_gap_tiny"
                    android:paddingEnd="@dimen/space_gap"
                    android:paddingBottom="@dimen/space_gap_tiny"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <!-- ── ① 统计概览：三列，数值用主色突出 ─────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="@dimen/space_card">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_page_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:text="@string/stat_duration"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statLangs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_page_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:text="@string/stat_langs"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statSpeakers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_page_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:text="@string/stat_speakers"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── ② 转写全文（格式下一轮细化；现在如实说没有内容）─────
                 ⚠️ AI 摘要与行动项**不做**（老师建议砍掉会议纪要）：这里只有原始记录。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/transcript_title"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4.98 筛选：**两栏**（说话人 / 语言），点标题就地展开选项，
                     再点一次收起。以前是一个"筛选"按钮 → 弹窗选发言人 → 再弹一次选语言
                     （用户反馈：要连点两次，而且每次弹窗里都有「清除筛选」，很别扭）。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/transcriptSpeakerHeader"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/touch_min"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:paddingStart="@dimen/space_gap"
                                android:paddingEnd="@dimen/space_gap"
                                android:text="@string/filter_speaker_any"
                                android:textColor="@color/ink_soft"
                                android:textSize="@dimen/text_caption" />

                            <LinearLayout
                                android:id="@+id/transcriptSpeakerOptions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_gap_small"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/transcriptLangHeader"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/touch_min"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:paddingStart="@dimen/space_gap"
                                android:paddingEnd="@dimen/space_gap"
                                android:text="@string/filter_lang_any"
                                android:textColor="@color/ink_soft"
                                android:textSize="@dimen/text_caption" />

                            <LinearLayout
                                android:id="@+id/transcriptLangOptions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/transcriptClear"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:gravity="center_vertical"
                        android:text="@string/filter_clear"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <!-- 外框高度**固定**：转写内容在里面自己上下滑（用户明确要求）。
                         卡片格式与会议中的字幕一致：同一份 item_subtitle_card 布局。

                         ⚠️ 4.98：这里是个"ScrollView 套 ScrollView"。有的机型（尤其国内 ROM）
                         内层会**拿不到滑动**（手指拖动的很可能是外层页面），用户实测一台能滑、
                         一台滑不动。三件事一起做：
                           ① nestedScrollingEnabled（API 21+ 的嵌套滚动协商）；
                           ② 代码里按下时 requestDisallowInterceptTouchEvent(true)，
                              让外层别抢这次手势（这是对付厂商 ROM 最可靠的一招）；
                           ③ 显示滚动条 —— 划不动时至少能看出"这里是可以滑的"。 -->
                    <ScrollView
                        android:id="@+id/transcriptScroll"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/transcript_box_height"
                        android:layout_marginTop="@dimen/space_gap_small"
                        android:background="@drawable/bg_input"
                        android:clipToPadding="false"
                        android:fillViewport="true"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="ifContentScrolls"
                        android:padding="@dimen/space_gap_small"
                        android:scrollbars="vertical">

                        <LinearLayout
                            android:id="@+id/transcriptList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                <TextView
                    android:id="@+id/transcriptEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:text="@string/transcript_empty"
                    android:textColor="@color/ink_faint"
                    android:textSize="@dimen/text_secondary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── ③ 导出（只导出这条记录已有的历史内容）─────────────── -->
            <Button
                android:id="@+id/detailExport"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/space_card"
                android:background="@drawable/tap_btn_primary"
                android:text="@string/export_word"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_button" />

            <Button
                android:id="@+id/detailDelete"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_section"
                android:background="@drawable/tap_btn_secondary"
                android:text="@string/hist_delete_local"
                android:textAllCaps="false"
                android:textColor="@color/err"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/detailBack"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/tap_btn_secondary"
                android:text="@string/common_back"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
