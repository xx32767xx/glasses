<?xml version="1.0" encoding="utf-8"?>
<!--
  page_history_detail.xml —— 单条历史记录的详情（4.69 先搭骨架）。

  ⚠️ 内容**下一轮才提供**：这一版只把卡片上已经有的信息摆好，并明说"字幕与逐句内容下一步"。
     不做假的页面（不摆空图表、不摆占位按钮）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_page">

            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_page_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_small"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detailKind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_brand"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingTop="@dimen/space_gap_tiny"
                    android:paddingEnd="@dimen/space_gap"
                    android:paddingBottom="@dimen/space_gap_tiny"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <!-- ── ① 统计概览：三列，数值用主色突出 ─────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="@dimen/space_card">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_page_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:text="@string/stat_duration"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statLangs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_page_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:text="@string/stat_langs"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statSpeakers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_page_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:text="@string/stat_speakers"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── ② 转写全文（格式下一轮细化；现在如实说没有内容）─────
                 ⚠️ AI 摘要与行动项**不做**（老师建议砍掉会议纪要）：这里只有原始记录。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/transcript_title"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <!-- 筛选入口：格式定下来之后再接功能，现在只是位置 -->
                    <TextView
                        android:id="@+id/transcriptFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="@dimen/space_gap"
                        android:paddingTop="@dimen/space_gap_tiny"
                        android:paddingEnd="@dimen/space_gap"
                        android:paddingBottom="@dimen/space_gap_tiny"
                        android:text="@string/transcript_filter"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/transcriptBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:textColor="@color/ink_soft"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- ── ③ 导出（只导出这条记录已有的历史内容）─────────────── -->
            <Button
                android:id="@+id/detailExport"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/space_card"
                android:background="@drawable/tap_btn_primary"
                android:text="@string/export_word"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_button" />

            <Button
                android:id="@+id/detailDelete"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_section"
                android:background="@drawable/tap_btn_secondary"
                android:text="@string/hist_delete_local"
                android:textAllCaps="false"
                android:textColor="@color/err"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/detailBack"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/tap_btn_secondary"
                android:text="@string/common_back"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
