<?xml version="1.0" encoding="utf-8"?>
<!--
  同传页。两种情况共用一个布局，靠 idleBlock / sessionBlock 的可见性切换：
    · 未开始：标题栏 + 连接卡片 + 语言方向 + 大留白（麦克风图标与提示）+ 主按钮
    · 进行中：运行状态栏 + 紧凑语言栏 + 字幕列表（权重吃满）+ 固定底部控制

  两条规范要求直接决定了这个结构：
    1. 底部控制**不随字幕滚动** —— 所以字幕列表是 weight=1 的滚动区，
       控制区在它下面固定；不是一个整页 ScrollView。
    2. 未开始的页面"不用滚动就能看到连接卡片" —— 所以留白用 weight=1，
       内容自然排在上面，不会把卡片挤下去。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- ══ 未开始 ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/idleBlock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 标题栏 56dp：只有标题 + 设置图标，不放宣传语 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_live"
                android:textColor="@color/ink"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/idleSettingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/tap_icon_bare"
                android:clickable="true"
                android:contentDescription="@string/nav_settings"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- 连接卡片：不滚动就能看到 -->
        <LinearLayout
            android:id="@+id/connectCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/tap_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="16dp">

            <View
                android:id="@+id/connectDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/connectTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/not_connected"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <!--
                  规范要求把"连接成功"和"服务可用"分开说：
                  网络通了但模型还在加载时，这里显示"模型准备中…"，
                  并且开始按钮是禁用的。文案由 setConnectionState() 决定。
                -->
                <TextView
                    android:id="@+id/connectSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/not_connected_hint"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/connectAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/connect_computer"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 语言方向：源语言 → 目标语言，中间可交换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/idleSourceLang"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/tap_pill_active"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/lang_pt_short"
                android:textColor="@color/on_brand"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/idleSwap"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_swap"
                android:clickable="true"
                android:contentDescription="@string/swap_sides"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_swap" />

            <TextView
                android:id="@+id/idleTargetLang"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/tap_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/lang_zh_short"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 大留白：轻量麦克风图标 + 提示 + 当前设置（不用假波形填满） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.35"
                android:contentDescription="@string/idle_hint_title"
                android:src="@drawable/ic_mic_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/idle_hint_title"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/idle_hint_body"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/idleSetupSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/current_setup"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 主按钮 + 禁用原因（规范：不能让人反复点才发现不能用） -->
        <TextView
            android:id="@+id/startReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/reason_need_connection"
            android:textColor="@color/warn"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/tap_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/startIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/start_interpreting"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/startLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/start_interpreting"
                android:textColor="@color/on_brand"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ 进行中 ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/sessionBlock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 运行状态：会话时长与连接状态**分开**显示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/sessionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/interpreting"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/sessionTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/sessionConn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 紧凑语言栏：只占一行，尽量把高度留给字幕 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/liveDirection"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/liveLangHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/lang_locked_hint"
                android:textColor="@color/ink_faint"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 字幕列表：每个片段"原文在上、译文在下"，连续列表不是聊天气泡 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/subtitleScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/subtitleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp" />
            </ScrollView>

            <TextView
                android:id="@+id/backToLatest"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/back_to_latest"
                android:textColor="@color/brand"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 字幕工具：不遮挡内容的轻量入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/toolMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/mode_bilingual"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/toolFontDown"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/font_smaller"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/toolFontUp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/font_larger"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/toolFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:drawableStart="@drawable/ic_fullscreen"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/fullscreen"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 底部控制：固定，不随字幕滚动 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <!-- 真实音量条 + 状态：没有讲话时也必须如实说"等待讲话" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/meter"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/micState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/mic_waiting"
                    android:textColor="@color/ink_soft"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 主操作：暂停/继续 + 结束 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/pauseButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/tap_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/pauseIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/pause"
                        android:src="@drawable/ic_pause" />

                    <TextView
                        android:id="@+id/pauseLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/pause"
                        android:textColor="@color/on_brand"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/endButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/tap_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/end_session"
                        android:textColor="@color/err"
                        android:textSize="16sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/outputButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/tap_icon_bare"
                    android:clickable="true"
                    android:contentDescription="@string/output_title"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/ic_speaker" />
            </LinearLayout>

            <!-- 暂停/断连这类"当前到底在做什么"的说明 -->
            <TextView
                android:id="@+id/sessionNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink_faint"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
