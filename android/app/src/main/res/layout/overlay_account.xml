<?xml version="1.0" encoding="utf-8"?>
<!--
  账户页（从设置进）。

  为什么需要"注册 / 登录"这一层：热词表原来靠手机自报用户名来区分数据，
  等于没有权限 —— 改一个参数就能读写别人的表。现在服务端只认 token，
  用户名只是 token 的属性。

  页面刻意保持朴素：用户名 + 密码 + 两个动作（注册 / 登录）+ 当前状态。
  不做的：找回密码、改密码、多设备管理 —— 局域网工具，真要换就重新注册一个。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/accountBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tap_icon_bare"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/account_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_intro"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <!-- 当前状态：登录着谁 / 没登录 -->
            <TextView
                android:id="@+id/accountState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:text="@string/account_state_none"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/accountUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:hint="@string/account_username"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/accountPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:hint="@string/account_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/accountRegister"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/tap_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/account_register"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/accountLogin"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/tap_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/account_login"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/accountLogout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/tap_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/account_logout"
                android:textColor="@color/err"
                android:textSize="14sp"
                android:visibility="gone" />

            <!--
              token 明文显示 + 可复制：这是给"万一要在别的设备上用"和排查用的。
              它等同于密码，所以只在登录后显示，并且明确写出这句话。
            -->
            <TextView
                android:id="@+id/accountTokenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/account_token_title"
                android:textColor="@color/ink_soft"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/accountToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/ink_soft"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/accountStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
