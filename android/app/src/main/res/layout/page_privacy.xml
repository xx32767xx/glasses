<?xml version="1.0" encoding="utf-8"?>
<!--
  page_privacy.xml —— 隐私政策（4.39，A2）。

  文案只写**这套系统实际做了什么**，不抄模板：
  音频去哪、字幕留多久、本机记录留多久、不采集什么、公网为什么要 TLS。
  规则来源：docs/21 §4（隐私）与 §4.38（音频轮转）、relay 的 /audio 与保留期清理。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_page">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/priv_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:text="@string/priv_subtitle"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:lineSpacingExtra="@dimen/space_gap_tiny"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:text="@string/priv_s1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:lineSpacingExtra="@dimen/space_gap_tiny"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:text="@string/priv_s2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:lineSpacingExtra="@dimen/space_gap_tiny"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:text="@string/priv_s3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:lineSpacingExtra="@dimen/space_gap_tiny"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:text="@string/priv_s4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:lineSpacingExtra="@dimen/space_gap_tiny"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:text="@string/priv_s5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:lineSpacingExtra="@dimen/space_gap_tiny"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:text="@string/priv_s6" />

        <Button
            android:id="@+id/privacyBack"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_field"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/priv_back"
            android:textColor="@color/ink"
            android:background="@drawable/tap_btn_secondary"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</ScrollView>
