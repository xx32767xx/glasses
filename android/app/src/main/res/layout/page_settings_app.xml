<?xml version="1.0" encoding="utf-8"?>
<!--
  page_settings_app.xml —— 新入口用的设置页（4.39，A2）。

  为什么另起一页而不是复用 page_settings.xml：那一页是**旧界面**（MainActivity）的底部导航页，
  id 与字符串都绑在它上面（主题/字号/显示模式/开发者模式…）。新入口（HomeActivity）只需要
  "连哪台服务器 + 我说什么语言 + 校对开关 + 隐私 + 清空本机记录"这几项。
  旧界面将来要下掉，这一页不该被它拖着。

  id 一律用 setApp 前缀，避免与旧页的 settings* 撞名（两页同时被 R 引用）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_page">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setAppStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_small"
            android:padding="@dimen/space_gap_small"
            android:background="@drawable/bg_card"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary"
            android:minHeight="@dimen/touch_min"
            android:text="" />

        <!-- ── 连接 ───────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/set_conn_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/setAppServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://117.50.180.93:8788"
            android:background="@drawable/bg_input"
            android:inputType="textUri"
            android:paddingStart="@dimen/space_gap"
            android:paddingEnd="@dimen/space_gap"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="@dimen/text_body" />

        <EditText
            android:id="@+id/setAppSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/home_hint_secret"
            android:background="@drawable/bg_input"
            android:inputType="text"
            android:paddingStart="@dimen/space_gap"
            android:paddingEnd="@dimen/space_gap"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="@dimen/text_body" />

        <Button
            android:id="@+id/setAppSave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button"
            android:layout_marginTop="@dimen/space_gap_small"
            android:background="@drawable/tap_btn_primary"
            android:text="@string/set_save_conn"
            android:textAllCaps="false"
            android:textColor="@color/on_brand"
            android:textSize="@dimen/text_button" />

        <!-- ── 我说什么语言 ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/rooms_my_lang_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_lang_hint"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setAppLangZh"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_field"
                android:layout_weight="1"
                android:text="@string/rooms_speak_zh"
                android:textColor="@color/ink"
                android:background="@drawable/tap_btn_secondary" />

            <Button
                android:id="@+id/setAppLangPt"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_field"
                android:layout_marginStart="@dimen/space_gap_small"
                android:layout_weight="1"
                android:text="@string/rooms_speak_pt"
                android:textColor="@color/ink"
                android:background="@drawable/tap_btn_secondary" />
        </LinearLayout>

        <!-- ── 界面语言（4.56）：中文 / Português / English ─────────────
             ⚠️ 与上面那两颗（我说话用什么语言）不是一回事：这里只换界面文字。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/ui_lang_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_lang_hint"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setAppUiLangZh"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_field"
                android:layout_weight="1"
                android:background="@drawable/tap_btn_secondary"
                android:text="@string/lang_zh"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/setAppUiLangPt"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_field"
                android:layout_marginStart="@dimen/space_gap_small"
                android:layout_weight="1"
                android:background="@drawable/tap_btn_secondary"
                android:text="Português"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/setAppUiLangEn"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_field"
                android:layout_marginStart="@dimen/space_gap_small"
                android:layout_weight="1"
                android:background="@drawable/tap_btn_secondary"
                android:text="@string/lang_en"
                android:textColor="@color/ink" />
        </LinearLayout>

        <!-- ── 校对 ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/set_proofread_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_proofread_hint"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary" />

        <Button
            android:id="@+id/setAppProofread"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_field"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:text="@string/set_loading"
            android:textColor="@color/ink"
            android:background="@drawable/tap_btn_secondary" />

        <!-- ── 隐私 ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/set_privacy"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/setAppPrivacy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_field"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:text="@string/set_privacy_link"
            android:textColor="@color/ink"
            android:background="@drawable/tap_btn_secondary" />

        <Button
            android:id="@+id/setAppClearRecords"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_field"
            android:layout_marginTop="@dimen/space_gap_small"
            android:text="@string/set_clear"
            android:textColor="@color/err"
            android:background="@drawable/tap_btn_secondary" />

        <Button
            android:id="@+id/setAppBack"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/common_back"
            android:textColor="@color/ink_soft"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/setAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption"
            android:text="" />
    </LinearLayout>
</ScrollView>
