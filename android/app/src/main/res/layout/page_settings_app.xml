<?xml version="1.0" encoding="utf-8"?>
<!--
  page_settings_app.xml —— 新入口用的设置页（4.39，A2）。

  为什么另起一页而不是复用 page_settings.xml：那一页是**旧界面**（MainActivity）的底部导航页，
  id 与字符串都绑在它上面（主题/字号/显示模式/开发者模式…）。新入口（HomeActivity）只需要
  "连哪台服务器 + 我说什么语言 + 校对开关 + 隐私 + 清空本机记录"这几项。
  旧界面将来要下掉，这一页不该被它拖着。

  id 一律用 setApp 前缀，避免与旧页的 settings* 撞名（两页同时被 R 引用）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_page">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setAppStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_small"
            android:padding="@dimen/space_gap_small"
            android:background="@drawable/bg_card"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary"
            android:minHeight="@dimen/touch_min"
            android:text="" />

        <!-- ── 连接 ───────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="服务器"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/setAppServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://117.50.180.93:8788"
            android:background="@drawable/bg_input"
            android:inputType="textUri"
            android:paddingStart="@dimen/space_gap"
            android:paddingEnd="@dimen/space_gap"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="@dimen/text_body" />

        <EditText
            android:id="@+id/setAppSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="共享密钥（start-all 横幅里那串）"
            android:background="@drawable/bg_input"
            android:inputType="text"
            android:paddingStart="@dimen/space_gap"
            android:paddingEnd="@dimen/space_gap"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_faint"
            android:textSize="@dimen/text_body" />

        <Button
            android:id="@+id/setAppSave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button"
            android:layout_marginTop="@dimen/space_gap_small"
            android:background="@drawable/tap_btn_primary"
            android:text="保存连接设置"
            android:textAllCaps="false"
            android:textColor="@color/on_brand"
            android:textSize="@dimen/text_button" />

        <!-- ── 我说什么语言 ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="我在会里说哪种语言"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="决定识别与翻译方向：我说中文，对方的话译成葡语；反之亦然。"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setAppLangZh"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_field"
                android:layout_weight="1"
                android:text="我说中文"
                android:textColor="@color/ink"
                android:background="@drawable/tap_btn_secondary" />

            <Button
                android:id="@+id/setAppLangPt"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_field"
                android:layout_marginStart="@dimen/space_gap_small"
                android:layout_weight="1"
                android:text="我说葡语"
                android:textColor="@color/ink"
                android:background="@drawable/tap_btn_secondary" />
        </LinearLayout>

        <!-- ── 校对 ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="译文校对（第二遍）"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="以电脑端为准：这个开关真正生效的地方在服务器，手机只是遥控器。"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary" />

        <Button
            android:id="@+id/setAppProofread"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_field"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:text="读取中…"
            android:textColor="@color/ink"
            android:background="@drawable/tap_btn_secondary" />

        <!-- ── 隐私 ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="隐私"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/setAppPrivacy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_field"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:text="隐私政策（音频与字幕去哪了）"
            android:textColor="@color/ink"
            android:background="@drawable/tap_btn_secondary" />

        <Button
            android:id="@+id/setAppClearRecords"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_field"
            android:layout_marginTop="@dimen/space_gap_small"
            android:text="清空本机记录（原文与译文）"
            android:textColor="@color/err"
            android:background="@drawable/tap_btn_secondary" />

        <Button
            android:id="@+id/setAppBack"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_section"
            android:text="返回"
            android:textColor="@color/ink_soft"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/setAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption"
            android:text="" />
    </LinearLayout>
</ScrollView>
