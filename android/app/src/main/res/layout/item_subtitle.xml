<?xml version="1.0" encoding="utf-8"?>
<!--
  一个字幕片段：时间标记 + 原文（灰、16sp）+ 译文（深、22sp）。

  规范明确不要"厚重边框或聊天气泡"，所以这里没有卡片背景，
  只有间距 + 一条细分隔线，读起来是连续的滚动字幕。
  字号在布局里给的是**基准值**，实际大小由代码按"字号"设置整体缩放
  （见 MainActivity.applyFontScale），所以三个 TextView 都带 id。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <TextView
        android:id="@+id/segTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_faint"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/segSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/ink_soft"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/segTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/segTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_tag_live"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="@string/tag_generating"
            android:textColor="@color/brand"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/segDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/divider" />
</LinearLayout>
