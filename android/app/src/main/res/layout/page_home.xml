<?xml version="1.0" encoding="utf-8"?>
<!--
  page_home.xml —— 启动后的第一屏：① 登录/注册 ② 首页（建房/加入/设置）。

  视觉按原型的浅色商务工具风格（4.47）：
    页面底 @color/page（#F2F5F7）· 卡片白 + 细描边 + 14dp 圆角
    主按钮走渐变（bg_btn_primary）· 次按钮白底描边（bg_btn_secondary）
    文字只有三级：ink（主）/ ink_soft（次）/ ink_faint（说明）
  ⚠️ 这里**不写任何色值与裸 dp/sp**：一律 @color/... 与 @dimen/...（深色模式与改版才不用改布局）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_page">

        <!-- 登录态才有的抬头（品牌 / 标语 / 我的语言）：进了首页就收起，
             首页有自己的问候与语言入口，不能两套抬头同时出现（4.60） -->
        <LinearLayout
            android:id="@+id/homeLoginHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_brand"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:text="@string/home_subtitle"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary" />

        </LinearLayout>

        <!-- 状态区：一行人类可读的信息（连接/错误/被顶下线都显示在这里） -->
        <TextView
            android:id="@+id/homeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap"
            android:background="@drawable/bg_card"
            android:minHeight="@dimen/touch_min"
            android:padding="@dimen/space_gap"
            android:text=""
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <!-- ── ① 注册 / 登录（原型：居中单列表单）────────────────────── -->
        <LinearLayout
            android:id="@+id/homeLoginBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 品牌图标：两个重叠的圆形，分别含「中」「A」 -->
            <FrameLayout
                android:layout_width="@dimen/brand_mark_width"
                android:layout_height="@dimen/brand_mark_height"
                android:layout_gravity="center_horizontal">

                <TextView
                    android:layout_width="@dimen/brand_dot_size"
                    android:layout_height="@dimen/brand_dot_size"
                    android:background="@drawable/bg_brand_circle"
                    android:gravity="center"
                    android:text="@string/brand_mark_zh"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_page_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="@dimen/brand_dot_size"
                    android:layout_height="@dimen/brand_dot_size"
                    android:layout_gravity="end|bottom"
                    android:background="@drawable/bg_brand_circle_alt"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_page_title"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap"
                android:text="@string/app_brand"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_page_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:gravity="center"
                android:text="@string/home_slogan"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_secondary" />

            <!-- 我的语言 = **界面语言**（4.59 澄清：这里选的是按钮和标题用哪种语言写；
                 说话用哪种语言在建会议时选）。语言名用它自己的语言写，
                 否则一个被切到巴葡、看不懂中文的人就再也切不回来了。 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:text="@string/home_my_lang"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_small"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/homeLangZh"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/lang_zh"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/homeLangEn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_gap_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/lang_en"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/homeLangPt"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_gap_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/lang_pt_native"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:text="@string/home_my_lang_hint"
                android:textColor="@color/ink_faint"
                android:textSize="@dimen/text_caption" />

            <!-- 用户名 -->
            <EditText
                android:id="@+id/homeUser"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/bg_input"
                android:hint="@string/home_hint_user"
                android:inputType="text"
                android:paddingStart="@dimen/space_gap"
                android:paddingEnd="@dimen/space_gap"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body" />

            <!-- 邮箱 + 获取验证码（同排）：**仅注册时显示**（登录不需要邮箱） -->
            <LinearLayout
                android:id="@+id/homeEmailRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_small"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/homeEmail"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_field"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/home_hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingEnd="@dimen/space_gap"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/homeSendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_field"
                    android:layout_marginStart="@dimen/space_gap_small"
                    android:background="@drawable/tap_btn_secondary"
                    android:minWidth="@dimen/button_compact_width"
                    android:text="@string/home_send_code"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <!-- 邮箱验证码 -->
            <EditText
                android:id="@+id/homeCode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap_small"
                android:background="@drawable/bg_input"
                android:hint="@string/home_hint_code"
                android:inputType="number"
                android:visibility="gone"
                android:paddingStart="@dimen/space_gap"
                android:paddingEnd="@dimen/space_gap"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body" />

            <!--
              密码：**原型表单里没有这一项**。保留是因为服务端目前的注册与登录都要密码
              （/auth/register-email 与 /auth/login）。等"验证码直登"的契约定下来再删。
              提示文案随「登录/注册」切换（Java 里改 hint），所以这里给个 id。
            -->
            <EditText
                android:id="@+id/homePass"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap_small"
                android:background="@drawable/bg_input"
                android:hint="@string/home_hint_pass"
                android:inputType="textPassword"
                android:paddingStart="@dimen/space_gap"
                android:paddingEnd="@dimen/space_gap"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body" />

            <!-- 用户协议与录音隐私政策（M4：不勾不许注册） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/homeAgree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/touch_min"
                    android:text="@string/home_agree_prefix" />

                <TextView
                    android:id="@+id/homeAgreeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/home_agree_links"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <!-- 全宽主按钮 -->
            <Button
                android:id="@+id/homeLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/tap_btn_primary"
                android:text="@string/home_login"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_button" />

            <!-- 登录 / 注册 切换：登录时**不显示**邮箱与验证码（4.50） -->
            <TextView
                android:id="@+id/homeRegisterToggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:gravity="center"
                android:text="@string/home_toggle_register"
                android:textColor="@color/brand"
                android:textSize="@dimen/text_secondary" />

            <!-- 服务器设置（高级）：默认收起，原型主表单里不出现 -->
            <TextView
                android:id="@+id/homeServerToggle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_gap_small"
                android:gravity="center"
                android:text="@string/home_server_toggle"
                android:textColor="@color/ink_faint"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:id="@+id/homeServerBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/homeServer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_field"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:background="@drawable/bg_input"
                    android:hint="@string/home_hint_server"
                    android:inputType="textUri"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingEnd="@dimen/space_gap"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="@dimen/text_body" />

                <EditText
                    android:id="@+id/homeSecret"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_field"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:background="@drawable/bg_input"
                    android:hint="@string/home_hint_secret"
                    android:inputType="text"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingEnd="@dimen/space_gap"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── ② 首页（4.60 按原型重做）─────────────────────────────────
             结构：顶部问候 + 界面语言入口 → 三张任务卡（创建 / 加入同级，同传翻译官通栏）
                   → 已支持语言卡片 → 两个弱化效用入口（旧版界面 / 退出登录）
             底部三项一级导航固定在屏幕底部（不在 ScrollView 里）。
             ⚠️ 这里不写色值与裸 dp：一律 @color / @dimen。 -->
        <LinearLayout
            android:id="@+id/homeMainBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 顶部：问候语 + 状态摘要，右侧是界面语言入口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_card">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/homeGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_page_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_secondary" />
                </LinearLayout>

                <!-- 界面语言入口：显示当前语言，点开三选一 -->
                <TextView
                    android:id="@+id/homeLangEntry"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_gap"
                    android:background="@drawable/bg_chip_brand"
                    android:clickable="true"
                    android:contentDescription="@string/home_lang_entry_desc"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingEnd="@dimen/space_gap"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ── 第一行：创建 / 加入（两个平级入口）────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/homeCardCreate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_tap"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:minHeight="@dimen/card_task_min_height"
                    android:orientation="vertical"
                    android:padding="@dimen/space_card">

                    <ImageView
                        android:layout_width="@dimen/icon_size_card"
                        android:layout_height="@dimen/icon_size_card"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_card_create"
                        android:tint="@color/brand" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_small"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/card_create_title"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:gravity="center"
                        android:maxLines="2"
                        android:minLines="2"
                        android:text="@string/card_create_desc"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeCardJoin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_gap_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_tap"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:minHeight="@dimen/card_task_min_height"
                    android:orientation="vertical"
                    android:padding="@dimen/space_card">

                    <ImageView
                        android:layout_width="@dimen/icon_size_card"
                        android:layout_height="@dimen/icon_size_card"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_card_join"
                        android:tint="@color/brand" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_small"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/card_join_title"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:gravity="center"
                        android:maxLines="2"
                        android:minLines="2"
                        android:text="@string/card_join_desc"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── 第二行：同传翻译官（独立场景，通栏；还没做，只摆前端）────
                 ⚠️ 不做假可用：卡上明写「即将上线」，点了没有反应（没有点击监听）。 -->
            <LinearLayout
                android:id="@+id/homeCardInterpreter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_small"
                android:background="@drawable/bg_card_brand_tint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_card">

                <ImageView
                    android:layout_width="@dimen/icon_size_card"
                    android:layout_height="@dimen/icon_size_card"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_card_interpreter"
                    android:tint="@color/brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_interp_title"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_gap_small"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="@dimen/space_gap_small"
                            android:paddingTop="@dimen/space_gap_tiny"
                            android:paddingEnd="@dimen/space_gap_small"
                            android:paddingBottom="@dimen/space_gap_tiny"
                            android:text="@string/card_interp_soon"
                            android:textColor="@color/ink_soft"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_gap_tiny"
                        android:text="@string/card_interp_desc"
                        android:textColor="@color/ink_soft"
                        android:textSize="@dimen/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── 已支持语言 ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_card"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_supported_title"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_brand"
                        android:paddingStart="@dimen/space_gap"
                        android:paddingTop="@dimen/space_gap_tiny"
                        android:paddingEnd="@dimen/space_gap"
                        android:paddingBottom="@dimen/space_gap_tiny"
                        android:text="@string/lang_zh"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_gap_small"
                        android:background="@drawable/bg_chip_brand"
                        android:paddingStart="@dimen/space_gap"
                        android:paddingTop="@dimen/space_gap_tiny"
                        android:paddingEnd="@dimen/space_gap"
                        android:paddingBottom="@dimen/space_gap_tiny"
                        android:text="@string/lang_pt_full"
                        android:textColor="@color/brand"
                        android:textSize="@dimen/text_secondary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:text="@string/home_supported_more"
                    android:textColor="@color/ink_faint"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- ── 弱化效用入口（不属于核心任务，所以只留文字链接）──────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:orientation="horizontal">

                <!-- 旧版界面：默认隐藏（见下方注释），需要对照/回退时改成 visible -->
                <TextView
                    android:id="@+id/homeLegacy"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/home_legacy"
                    android:textColor="@color/ink_faint"
                    android:textSize="@dimen/text_secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/homeLogout"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/home_logout"
                    android:textColor="@color/err"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>
        </LinearLayout>
            <!-- 旧版界面入口的历史说明：4.48 起默认隐藏。旧版 App 已冻结（不再加功能），
                 但代码保留 —— 它是「同传翻译官」的参考实现（收音 / 上传 / 长轮询 / 字幕成对 /
                 眼镜投屏与折行翻页都在里面）。需要对照或回退时，把上面 homeLegacy 的
                 visibility 改成 visible 即可，不用改 Java（点击监听一直有效）。 -->
        </LinearLayout>
    </ScrollView>

    <!-- 底部一级导航：与「我的」页共用同一个片段（4.62 抽出） -->
    <include layout="@layout/inc_bottom_nav" />
</LinearLayout>
