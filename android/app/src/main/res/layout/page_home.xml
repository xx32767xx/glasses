<?xml version="1.0" encoding="utf-8"?>
<!--
  page_home.xml —— 启动后的第一屏：① 登录/注册 ② 首页（建房/加入/设置）。

  视觉按原型的浅色商务工具风格（4.47）：
    页面底 @color/page（#F2F5F7）· 卡片白 + 细描边 + 14dp 圆角
    主按钮走渐变（bg_btn_primary）· 次按钮白底描边（bg_btn_secondary）
    文字只有三级：ink（主）/ ink_soft（次）/ ink_faint（说明）
  ⚠️ 这里**不写任何色值与裸 dp/sp**：一律 @color/... 与 @dimen/...（深色模式与改版才不用改布局）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_page">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_brand"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:text="@string/home_subtitle"
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_secondary" />

        <!-- 界面语言（4.56）：中文 / Português / English。
             ⚠️ 与表单里的「我的语言」不是一回事：那个决定**我说话**用哪种语言（影响识别与翻译方向），
             这个只决定按钮和标题用哪种语言写字。语言名一律用它自己的语言写
             （Português / English），否则还没切过去的人根本认不出来。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap_tiny"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeUiLangZh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_gap_small"
                android:paddingTop="@dimen/space_gap_tiny"
                android:paddingEnd="@dimen/space_gap_small"
                android:paddingBottom="@dimen/space_gap_tiny"
                android:text="@string/lang_zh"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/homeUiLangPt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_gap_small"
                android:paddingTop="@dimen/space_gap_tiny"
                android:paddingEnd="@dimen/space_gap_small"
                android:paddingBottom="@dimen/space_gap_tiny"
                android:text="Português"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/homeUiLangEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_gap_small"
                android:paddingTop="@dimen/space_gap_tiny"
                android:paddingEnd="@dimen/space_gap_small"
                android:paddingBottom="@dimen/space_gap_tiny"
                android:text="@string/lang_en"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- 状态区：一行人类可读的信息（连接/错误/被顶下线都显示在这里） -->
        <TextView
            android:id="@+id/homeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_gap"
            android:background="@drawable/bg_card"
            android:minHeight="@dimen/touch_min"
            android:padding="@dimen/space_gap"
            android:text=""
            android:textColor="@color/ink_soft"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <!-- ── ① 注册 / 登录（原型：居中单列表单）────────────────────── -->
        <LinearLayout
            android:id="@+id/homeLoginBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 品牌图标：两个重叠的圆形，分别含「中」「A」 -->
            <FrameLayout
                android:layout_width="@dimen/brand_mark_width"
                android:layout_height="@dimen/brand_mark_height"
                android:layout_gravity="center_horizontal">

                <TextView
                    android:layout_width="@dimen/brand_dot_size"
                    android:layout_height="@dimen/brand_dot_size"
                    android:background="@drawable/bg_brand_circle"
                    android:gravity="center"
                    android:text="@string/brand_mark_zh"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_page_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="@dimen/brand_dot_size"
                    android:layout_height="@dimen/brand_dot_size"
                    android:layout_gravity="end|bottom"
                    android:background="@drawable/bg_brand_circle_alt"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_page_title"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap"
                android:text="@string/app_brand"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_page_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:gravity="center"
                android:text="@string/home_slogan"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_secondary" />

            <!-- 我的语言 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:text="@string/home_my_lang"
                android:textColor="@color/ink_soft"
                android:textSize="@dimen/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_small"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/homeLangZh"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/lang_zh"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/homeLangEn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_gap_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:enabled="false"
                    android:text="@string/lang_en"
                    android:textColor="@color/ink_faint"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/homeLangPt"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_gap_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/lang_pt_br"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:text="@string/home_lang_en_locked"
                android:textColor="@color/ink_faint"
                android:textSize="@dimen/text_caption" />

            <!-- 用户名 -->
            <EditText
                android:id="@+id/homeUser"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/bg_input"
                android:hint="@string/home_hint_user"
                android:inputType="text"
                android:paddingStart="@dimen/space_gap"
                android:paddingEnd="@dimen/space_gap"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body" />

            <!-- 邮箱 + 获取验证码（同排）：**仅注册时显示**（登录不需要邮箱） -->
            <LinearLayout
                android:id="@+id/homeEmailRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap_small"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/homeEmail"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_field"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/home_hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingEnd="@dimen/space_gap"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/homeSendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_field"
                    android:layout_marginStart="@dimen/space_gap_small"
                    android:background="@drawable/tap_btn_secondary"
                    android:minWidth="@dimen/button_compact_width"
                    android:text="@string/home_send_code"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <!-- 邮箱验证码 -->
            <EditText
                android:id="@+id/homeCode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap_small"
                android:background="@drawable/bg_input"
                android:hint="@string/home_hint_code"
                android:inputType="number"
                android:visibility="gone"
                android:paddingStart="@dimen/space_gap"
                android:paddingEnd="@dimen/space_gap"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body" />

            <!--
              密码：**原型表单里没有这一项**。保留是因为服务端目前的注册与登录都要密码
              （/auth/register-email 与 /auth/login）。等"验证码直登"的契约定下来再删。
              提示文案随「登录/注册」切换（Java 里改 hint），所以这里给个 id。
            -->
            <EditText
                android:id="@+id/homePass"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_field"
                android:layout_marginTop="@dimen/space_gap_small"
                android:background="@drawable/bg_input"
                android:hint="@string/home_hint_pass"
                android:inputType="textPassword"
                android:paddingStart="@dimen/space_gap"
                android:paddingEnd="@dimen/space_gap"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body" />

            <!-- 用户协议与录音隐私政策（M4：不勾不许注册） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/homeAgree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/touch_min"
                    android:text="@string/home_agree_prefix" />

                <TextView
                    android:id="@+id/homeAgreeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/home_agree_links"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <!-- 全宽主按钮 -->
            <Button
                android:id="@+id/homeLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@drawable/tap_btn_primary"
                android:text="@string/home_login"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_button" />

            <!-- 登录 / 注册 切换：登录时**不显示**邮箱与验证码（4.50） -->
            <TextView
                android:id="@+id/homeRegisterToggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_gap_tiny"
                android:gravity="center"
                android:text="@string/home_toggle_register"
                android:textColor="@color/brand"
                android:textSize="@dimen/text_secondary" />

            <!-- 服务器设置（高级）：默认收起，原型主表单里不出现 -->
            <TextView
                android:id="@+id/homeServerToggle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_gap_small"
                android:gravity="center"
                android:text="@string/home_server_toggle"
                android:textColor="@color/ink_faint"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:id="@+id/homeServerBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/homeServer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_field"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:background="@drawable/bg_input"
                    android:hint="@string/home_hint_server"
                    android:inputType="textUri"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingEnd="@dimen/space_gap"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="@dimen/text_body" />

                <EditText
                    android:id="@+id/homeSecret"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_field"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:background="@drawable/bg_input"
                    android:hint="@string/home_hint_secret"
                    android:inputType="text"
                    android:paddingStart="@dimen/space_gap"
                    android:paddingEnd="@dimen/space_gap"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── ② 首页 ────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/homeMainBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_card"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_card">

                <TextView
                    android:id="@+id/homeWho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_gap_tiny"
                    android:text="@string/home_greeting"
                    android:textColor="@color/ink_soft"
                    android:textSize="@dimen/text_secondary" />

                <Button
                    android:id="@+id/homeCreate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_button"
                    android:layout_marginTop="@dimen/space_card"
                    android:background="@drawable/tap_btn_primary"
                    android:text="@string/home_rooms"
                    android:textAllCaps="false"
                    android:textColor="@color/on_brand"
                    android:textSize="@dimen/text_button" />

                <Button
                    android:id="@+id/homeSettings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_field"
                    android:layout_marginTop="@dimen/space_gap"
                    android:background="@drawable/tap_btn_secondary"
                    android:text="@string/home_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />

                <!--
                  旧版界面入口：4.48 起**默认隐藏**。
                  旧版 App 已冻结（不再加功能），但代码保留 —— 它是「同传翻译官」的参考实现
                  （收音 / 上传 / 长轮询 / 字幕成对 / 眼镜投屏与折行翻页都在里面）。
                  需要对照或回退时，把 visibility 改成 visible 即可，不用改 Java
                  （HomeActivity 里的点击监听一直有效）。
                -->
                <Button
                    android:id="@+id/homeLegacy"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_field"
                    android:layout_marginTop="@dimen/space_gap_small"
                    android:background="@drawable/tap_btn_secondary"
                    android:text="@string/home_legacy"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_soft"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/homeLogout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_gap"
                android:background="@android:color/transparent"
                android:text="@string/home_logout"
                android:textAllCaps="false"
                android:textColor="@color/err"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
