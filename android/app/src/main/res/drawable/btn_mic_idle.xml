<?xml version="1.0" encoding="utf-8"?>
<!-- 开麦按钮（空闲）：蓝绿渐变胶囊（原型：主按钮渐变 + 胶囊形） -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_dark">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/brand_grad_start"
                android:endColor="@color/brand_grad_end" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</ripple>
