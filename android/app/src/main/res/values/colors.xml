<?xml version="1.0" encoding="utf-8"?>
<!--
  配色 token。**界面里只许写语义名**（@color/ink 这些），不许写死色值 ——
  写死了就不会跟着深色变（android/README.md 的硬约束 2）。

  取值来自老师原型的视觉体系（4.47 对齐）：
    品牌主色 #0E7490 / 深主色 #0B5C73 / 主按钮渐变 #0E7490 → #0891B2（135°）
    页面背景 #F2F5F7 / 卡片 #FFFFFF / 主文字 #16242F / 次要文字 #64748B
    分隔线 #E3E8EE / 辅助强调（琥珀）#D97706
    眼镜预览底色 #0A0F14 / 眼镜字幕 #4ADE80

  ⚠️ 原型给的是 CSS 像素；Android 侧走 dp/sp 体系（见 res/values/dimens.xml），
     不照搬数字，只搬运"层级关系"。
-->
<resources>
    <!-- 页面与卡片 -->
    <color name="page">#F2F5F7</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_alt">#EDF3F5</color>
    <color name="line">#E3E8EE</color>
    <color name="line_soft">#EEF2F5</color>

    <!-- 文字 -->
    <color name="ink">#16242F</color>
    <color name="ink_soft">#64748B</color>
    <color name="ink_faint">#94A3B8</color>

    <!-- 主色：只出现在"主操作"和"当前选中"上 -->
    <color name="brand">#0E7490</color>
    <color name="brand_dark">#0B5C73</color>
    <color name="brand_soft">#E6F4F7</color>
    <color name="on_brand">#FFFFFF</color>
    <!-- 主按钮渐变的两端（drawable/bg_btn_primary.xml 用，135° = Android 的 315） -->
    <!-- 渐变卡上的次要文字（4.62）：白色压暗，别用 alpha 拼一个色值出来容易糊 -->
    <color name="on_brand_dim">#D8EEF3</color>
    <color name="brand_grad_start">#0E7490</color>
    <color name="brand_grad_end">#0891B2</color>

    <!-- 辅助强调（琥珀）：用于"提示/待处理"，永远配文字出现 -->
    <color name="accent">#D97706</color>
    <color name="accent_soft">#FDF3E3</color>

    <!-- 状态色。规范要求"颜色 + 文字说明"，所以这三色永远和文字一起出现 -->
    <color name="ok">#12B76A</color>
    <color name="ok_soft">#E9F9F1</color>
    <color name="warn">#F79009</color>
    <color name="warn_soft">#FFF6E8</color>
    <color name="err">#D92D20</color>
    <color name="err_soft">#FEF1F0</color>
    <color name="idle">#94A3B8</color>

    <!-- 录音态：唯一允许抢注意力的颜色 -->
    <color name="rec">#D92D20</color>
    <color name="rec_dark">#B42318</color>

    <!--
      「眼镜显示预览」那块深色屏幕：深浅两种模式下都保持深色 ——
      它模拟的是设备屏幕，不是页面的一部分（原型：底 #0A0F14、字幕 #4ADE80）。
    -->
    <color name="screen">#0A0F14</color>
    <color name="screen_line">#1F2A33</color>
    <color name="screen_ink">#4ADE80</color>
    <color name="screen_ink_dim">#7C8B93</color>

    <color name="ripple_light">#14000000</color>
    <color name="ripple_dark">#33FFFFFF</color>

    <!-- 音量条：底槽 + 已点亮 -->
    <color name="meter_track">#E3E8EE</color>
    <color name="meter_on">#0E7490</color>
</resources>
