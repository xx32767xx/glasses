<?xml version="1.0" encoding="utf-8"?>
<!-- 底部弹层升起。规范要求"动画只用于表示真实的状态变化"，这是弹层出现的空间关系，不是装饰 -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <translate
        android:duration="180"
        android:fromYDelta="100%"
        android:toYDelta="0" />
    <alpha
        android:duration="180"
        android:fromAlpha="0.6"
        android:toAlpha="1.0" />
</set>
